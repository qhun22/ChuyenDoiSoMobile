{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuyendoisomobile",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "TURNSTILE_SECRET_KEY": "0x4AAAAAAE_tRiGFPZCrBWNBeD_5OzY95es"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "chuyendoisomobile"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qhun_mobile_db",
      "database_id": "9ddbac15-33b1-4c4b-b955-29054cfd1aea"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "chuyendoisomobile-uploads"
    }
  ]
}
